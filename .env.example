# Secret placeholders and non-secret defaults. Not automatically loaded.
# Shared allowlist; the webhook secret belongs only to intake.
# For the dedicated live demo use yxshxsmv/auditor-demo after it is created.
# Deployment automation prompts locally for secrets and keeps them only in
# .demo-private/secrets.json (mode 600, gitignored) and the intended Lambda.
# See docs/live_demo.md. Do not paste credentials into chat or record setup.
# The target repository is documented in README.md.
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_SECRET
GITHUB_REPOSITORY=OWNER/REPOSITORY

# AWS entry points are guarded. Keep false for all current local work.
# Explicit client-injected factories do not need this flag.
# Enable only in a separately approved deployment; it permits SDK construction
# and credential discovery on first invocation, not during module import.
ENABLE_AWS_RUNTIME=false
# Intake only: configured function name/ARN, optionally with an alias/version.
WORKER_FUNCTION_NAME=REPLACE_WITH_WORKER_FUNCTION_NAME

# Settings.from_env() reads these for explicit adapter composition.
# Pure handler/factory tests use injected dependencies and create no live clients.
# Worker event v1 is a flat, 1024-byte bounded identity object, never configuration.
# Choose explicitly: disabled (safe default), rules (local), or groq (mocked here).
# For a future rules-only worker, choose rules explicitly; disabled fails startup.
REVIEW_PROVIDER=disabled
# Groq runs baseline rules alongside AI. This flag only permits rules-only output
# when the configured AI provider is unavailable; malformed output still fails.
ENABLE_RULE_FALLBACK=false
ENABLE_LIVE_GROQ=false
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL_ID=REPLACE_WITH_A_MANUALLY_VERIFIED_MODEL
GROQ_API_KEY=REPLACE_WITH_A_GROQ_API_KEY
GROQ_TIMEOUT_SECONDS=15
GROQ_MAX_RESPONSE_BYTES=96000

# GitHub API credential for the review worker; not an AWS setting.
GITHUB_TOKEN=REPLACE_WITH_A_REPOSITORY_SCOPED_TOKEN

# AWS_REGION is supplied automatically by Lambda; this placeholder is for local
# fake configuration only. Do not add AWS_REGION as a custom Lambda variable.
# The worker table must already exist; the application never creates it.
# Both runtime initializers use AWS_REGION; DYNAMODB_TABLE_NAME is worker-only.
# Existing worker Settings validates both even with mocks/rules. Tests use fakes.
AWS_REGION=REPLACE_WITH_YOUR_REGION
DYNAMODB_TABLE_NAME=REPLACE_WITH_THE_DEPLOYED_TABLE_NAME

# Archived compatibility settings only. Bedrock is not part of the live path.
ENABLE_LIVE_BEDROCK=false
# BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Non-secret size/token defaults; limits apply to the entire review input.
MAX_DIFF_BYTES=16000
MAX_FILES=50
MAX_MODEL_INPUT_BYTES=24000
MAX_OUTPUT_TOKENS=1024
